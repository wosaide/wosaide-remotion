{
  "name": "wosaide-remotion-brandmark",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts WOSAideBrand out/WOSAide-Brand.mp4 --codec=h264 --crf=12",
    "render:filament": "remotion render src/index.ts BirdFilament out/bird-filament.webm --codec=vp8 --pixel-format=yuva420p --image-format=png",
    "still": "remotion still src/index.ts WOSAideBrand out/WOSAide-Brand-final.png --frame=135",
    "typecheck": "tsc --noEmit",
    "icons:build": "bash scripts/build-icon-kit.sh",
    "icons:verify": "bash scripts/verify-icon-kit.sh",
    "icons:version": "cat icons/CURRENT"
  },
  "dependencies": {
    "@remotion/cli": "4.0.518",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.518"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
